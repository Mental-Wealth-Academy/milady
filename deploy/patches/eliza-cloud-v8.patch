diff --git a/packages/app-core/deploy/Dockerfile.ci b/packages/app-core/deploy/Dockerfile.ci
index e1302a1477..e20a15a55a 100644
--- a/packages/app-core/deploy/Dockerfile.ci
+++ b/packages/app-core/deploy/Dockerfile.ci
@@ -20,11 +20,64 @@ FROM node:${NODE_VERSION}-slim AS pruner
 WORKDIR /app
 COPY . .
 
-RUN node eliza/packages/app-core/scripts/relink-workspace-packages-to-dist.mjs \
-  @elizaos/agent
+# ===== FIX: Pre-compile workspace packages to prevent tsx runtime hang =====
+# Workspace symlinks point to raw TypeScript source. tsx/esbuild tries to
+# compile everything at runtime and hangs. Fix: build dist/ for all workspace
+# packages so tsx uses compiled JS. Install bun for the build steps.
+RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates unzip && rm -rf /var/lib/apt/lists/*
+RUN curl -fsSL https://bun.sh/install | bash
+ENV PATH="/root/.bun/bin:$PATH"
+
+# Build @elizaos/core (needs buf for proto generation)
+RUN curl -sSL "https://github.com/bufbuild/buf/releases/download/v1.50.0/buf-Linux-x86_64" -o /usr/local/bin/buf && chmod +x /usr/local/bin/buf
+RUN cd eliza/packages/schemas && buf dep update && buf generate 2>&1 || true
+RUN cd eliza/packages/typescript && bun run build.ts 2>&1 || true
+
+# Build workspace packages that tsx would otherwise compile at runtime
+RUN cd eliza/packages/agent && bun run build 2>&1 || bun run build:dist 2>&1 || true
+RUN cd eliza/packages/shared && bun run build 2>&1 || true
+RUN cd eliza/packages/app-core && bun run build 2>&1 || true
+
+RUN echo "=== Workspace dist check ==="; \
+    for pkg in eliza/packages/typescript eliza/packages/agent eliza/packages/shared; do \
+      if [ -d "$pkg/dist" ]; then echo "  OK: $pkg/dist"; else echo "  MISS: $pkg/dist"; fi; \
+    done
+# ===== END FIX =====
 
 # Patch plugin-agent-skills getCatalogStats crash (alpha.11 vs alpha.66 interface mismatch)
 RUN sed -i 's/const stats = service.getCatalogStats();/const stats = typeof service.getCatalogStats === "function" ? service.getCatalogStats() : { loaded: 0, total: 0, storageType: "unknown" };/g' node_modules/@elizaos/plugin-agent-skills/dist/index.js 2>/dev/null || true
+
+# ===== CLOUD RUNTIME PATCHES =====
+# Patch: TEXT_EMBEDDING crash on empty text (old dist throws instead of returning zero vector)
+RUN embed_js="$(find node_modules/@elizaos/plugin-local-embedding -name 'index.js' -path '*/dist/*' 2>/dev/null | head -1)"; \
+    [ -f "$embed_js" ] && sed -i 's/throw new Error("TEXT_EMBEDDING requires non-empty text");/return new Array(384).fill(0);/' "$embed_js" || true
+
+# Patch: SQL guard for getRelationships (empty entityId crash)
+RUN sql_js="$(find node_modules/@elizaos/plugin-sql -name 'index.node.js' -path '*/dist/*' 2>/dev/null | head -1)"; \
+    [ -f "$sql_js" ] && sed -i 's/async getRelationships(params) {/async getRelationships(params) {\n    if (!params?.entityId \&\& !params?.entityIds?.length) return [];/' "$sql_js" || true
+
+# Patch: Disable newer-message cancellation (causes typing loops in group chats)
+RUN for f in $(find node_modules/@elizaos/core/dist -name '*.js' 2>/dev/null); do \
+      sed -i 's/if (currentResponseId !== responseId && !opts.keepExistingResponses)/if (false)/g' "$f" 2>/dev/null || true; \
+    done
+
+# Patch: roles.js shim (dist/roles.js may be missing from npm package)
+RUN core_dir="node_modules/@elizaos/core"; \
+    if [ -d "$core_dir/dist" ]; then \
+      mkdir -p "$core_dir/dist/browser"; \
+      if [ ! -f "$core_dir/dist/roles.js" ]; then \
+        if [ -f "$core_dir/dist/browser/roles.js" ]; then \
+          echo 'export * from "./browser/roles.js";' > "$core_dir/dist/roles.js"; \
+        elif [ -d "$core_dir/src" ]; then \
+          echo 'export * from "../src/roles.ts";' > "$core_dir/dist/roles.js"; \
+        fi; \
+      fi; \
+      if [ ! -f "$core_dir/dist/browser/roles.js" ] && [ -d "$core_dir/src" ]; then \
+        echo 'export * from "../../src/roles.ts";' > "$core_dir/dist/browser/roles.js"; \
+      fi; \
+    fi
+# ===== END CLOUD RUNTIME PATCHES =====
+
 ARG VERSION_CLEAN
 
 # Patch autonomous version
diff --git a/packages/app-core/src/api/server.ts b/packages/app-core/src/api/server.ts
index d1f614a15f..8dd9c0cfe9 100644
--- a/packages/app-core/src/api/server.ts
+++ b/packages/app-core/src/api/server.ts
@@ -991,6 +991,11 @@ async function handleCompatRoute(
     return true;
   }
 
+  // Exempt non-API paths (static assets, SPA routes) from the compat auth catch-all
+  if (!url.pathname.startsWith("/api/") && !url.pathname.startsWith("/v1/") && !url.pathname.startsWith("/ws")) {
+    return false;
+  }
+
   if (!ensureCompatApiAuthorized(req, res)) return true;
   return handleDatabaseRowsCompatRoute(req, res, state.current);
 }
